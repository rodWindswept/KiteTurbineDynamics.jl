#!/usr/bin/env bash
# .githooks/pre-commit — habit-hook sensors, fired live at commit time.
# Version: 0.3.0 | Date: 2026-10-19 | Author: Windswept & Interesting
#
# Runs the deterministic sensors on staged files and blocks on breach.
# Sensors: ste (STE-100 prose), provenance (campaign CSV stamp) and extract
# (sweep stale-phrase transcripts match the revision their stamp names).
# Cue: tdd (src change with no test change) — it warns, it does not block.
# Deliberate bypass: git commit --no-verify
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

STAGED=$(git diff --cached --name-only --diff-filter=ACM)
FAIL=0

# 1. STE linter on staged markdown (blocks at >= 2.0 violations/100w)
MD_FILES=$(printf '%s\n' "$STAGED" | grep -E '\.(md|markdown)$' || true)
# STE exemption list (.ste-exempt): two classes, both declared in dated
# entries — amend-only historical ledgers (new entries still STE-clean) and
# verbatim transcripts (exempt because they are records, not our prose).
# Exact whole-line match; a dated or padded path does not exempt.
if [ -f .ste-exempt ]; then
    MD_FILES=$(printf '%s\n' "$MD_FILES" | grep -vxFf <(grep -vE '^\s*(#|$)' .ste-exempt) || true)
fi
if [ -n "$MD_FILES" ]; then
    python3 ste-lint.py --fail-above 2.0 $MD_FILES || FAIL=1
fi

# 2. Provenance on staged campaign CSVs
CSV_FILES=$(printf '%s\n' "$STAGED" | grep -E '\.csv$' || true)
if [ -n "$CSV_FILES" ]; then
    python3 check-provenance.py $CSV_FILES || FAIL=1
fi

# 3. Sweep extract transcripts: a staged copy must be byte-identical to
#    docs/agents/stale-phrases.md at the rev its stamp line names. Reads the
#    index, not the working tree. Absent copies pass; missing revs fail closed.
python3 check-extract-stamp.py || FAIL=1

# 4. TDD cue: a src/ change with no test change. WARN only, never blocks: a pure
#    refactor or a comment fix legitimately touches src/ alone.
if [ -n "$STAGED" ]; then
    python3 check-tdd-evidence.py $STAGED || true
fi

if [ "$FAIL" = "1" ]; then
    echo ""
    echo "Habit-hook sensors fired. Fix the [HOOK:...] items above, then re-commit."
    echo "Deliberate bypass: git commit --no-verify"
    exit 1
fi
exit 0
