# Large campaign outputs that can be regenerated from source
scripts/results/**/stdout.log
scripts/results/**/stderr.log
scripts/results/**/campaign.log
scripts/results/**/checkpoint.jls
scripts/results/**/*.jls

# Julia compilation caches
*.jl.cov
*.jl.*.cov
*.jl.mem
deps/deps.jl
deps/build.log
docs/build/
docs/site/

# Local Julia depot (sandbox workaround: ~/.julia is read-only and /tmp is
# ephemeral per command, so the depot lives in the workspace). Never commit.
.julia_depot/

# Python caches
__pycache__/
*.pyc

# Editor
.vscode/
.idea/
*.swp
.DS_Store

run_all_sims.log
sweep_*.log

# Monitor working files
scripts/results/trpt_opt_v2/.last_refresh_stamp
scripts/results/trpt_opt_v2/.stop_monitor
scripts/results/trpt_opt_v2/auto_refresh.log
parameter_trace.csv
island_bests.csv
trajectory_analysis/
*.log
*.aux
.claude/worktrees/

# Temporary/monitor CSVs — but NOT campaign results
*.csv
!scripts/results/**/*.csv

# Local python libs (sandbox workaround). Never commit.
.pylibs/
