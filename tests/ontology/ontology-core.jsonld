      "source": "standard-physics"
    },
    {
      "@id": "https://windswept.energy/ontology/tether_taper_benefit",
      "class": "DesignPrinciple",
      "canonical_name": "",
      "definition": "The design rule that section diameters may be reduced where the local load allows, saving mass and drag. In Pyramid and Daisy the rotor ring is the largest diameter and the lowest ring the smallest, so the step-down direction reads rotor to ground.",
      "symbol": "",
      "dimension": "",
      "unit_si": "",
      "unit_paper": "",
      "strict_synonyms": [
        "tether drag importance",
        "tether drag reduction",
        "tether_taper_benefit"
