    {
      "@id": "https://windswept.energy/ontology/tsr_tradeoff",
      "class": "DesignPrinciple",
      "canonical_name": "",
      "definition": "The design rule that the tip speed ratio carries a working optimum between two losses: too low starves the power coefficient, too high spends the gain on profile and tether drag and pushes the tips toward the noise and structural limits. The optimum is a design point, not a constant.",
      "symbol": "",
      "dimension": "",
      "unit_si": "",
      "unit_paper": "",
      "strict_synonyms": [
        "BEM accuracy limitation",
        "design trade-offs",
        "linear variation assumption",
        "neglect gravity assumption",
        "rotor design",
        "tsr_tradeoff"
      ],
