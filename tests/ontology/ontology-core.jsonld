    {
      "@id": "https://windswept.energy/ontology/taper_direction",
      "class": "DesignPrinciple",
      "canonical_name": "",
      "definition": "The direction the diameter steps run along the shaft. In Pyramid and Daisy the direction reads large at the rotor, smaller toward the ground. The tension profile that justifies the direction is unmeasured directly; the trusted authority reads Tallak Tveide (tallakt).",
      "symbol": "",
      "dimension": "",
      "unit_si": "",
      "unit_paper": "",
      "strict_synonyms": [
        "rigid blades",
        "taper_direction"
      ],
