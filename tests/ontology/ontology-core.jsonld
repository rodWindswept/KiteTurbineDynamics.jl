    {
      "@id": "https://windswept.energy/ontology/betz_goldstein_limit",
      "target": "power_coefficient_quantity",
      "rule_type": "physical_ceiling",
      "expression": "Cp <= 16/27",
      "severity": "fatal",
      "message": "Power coefficient violates the Betz limit.",
      "status": "checked",
      "source": "Betz limit; R33 founder boundary (25 kW demand against 19.3 kW ceiling)"
    },
    {
      "@id": "https://windswept.energy/ontology/torsional_stability_warning",
      "target": "collapse_margin",
      "rule_type": "stability_criterion",
      "expression": "collapse_margin < delta_peak / delta_crit",
      "severity": "warning",
      "message": "Operating twist reached the restoring-torque peak; past this the system heads toward the zero crossing.",
      "status": "checked",
      "source": "R17 founder ruling (zero crossing is the collapse; the peak is the warning); R57 ratio standardisation"
    },
    {
      "@id": "https://windswept.energy/ontology/torsional_collapse_fatal",
      "target": "critical_twist_angle",
      "rule_type": "stability_criterion",
      "expression": "delta_operating < delta_crit",
      "severity": "fatal",
      "message": "Operating twist reached the zero crossing of the restoring torque.",
      "status": "checked",
      "source": "R17 founder ruling; torque_twist_relation"
    },
    {
      "@id": "https://windswept.energy/ontology/positive_tension_constraint",
      "target": "tether_tension",
      "rule_type": "boundary",
      "expression": "max(T_section) > 0",
      "severity": "fatal",
      "message": "The full set of tethers in a section has gone slack; the TRPT cannot transmit torque for that time.",
      "status": "checked",
      "source": "R19 and R20 founder rulings; R56 founder refinement (a single tether may go slack while transmission continues; full-section slack kills torque transmission)"
    }
  ]
}
