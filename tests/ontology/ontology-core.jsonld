    {
      "@id": "https://windswept.energy/ontology/bank_angle_limit",
      "class": "DesignPrinciple",
      "canonical_name": "",
      "definition": "The design rule that the blade bank angle stays inside a stated bound about the rotor swept plane. Beyond the bound, one side of the rotor unloads and the structure takes a lopsided load. The bound value is an instance property.",
      "symbol": "",
      "dimension": "",
      "unit_si": "",
      "unit_paper": "",
      "strict_synonyms": [
        "AD_not_valid_Region_I",
        "bank_angle_limit",
        "hinged blade design"
      ],
      "related_terms": [
