#!/usr/bin/env bash
# .githooks/pre-commit — habit-hook sensors, fired live at commit time.
# Version: 0.2.0 | Date: 2026-09-24 | Author: Windswept & Interesting
#
# Runs the deterministic sensors on staged files and blocks on breach.
# Sensors: ste (STE-100 prose) and provenance (campaign CSV stamp).
# Cue: tdd (src change with no test change) — it warns, it does not block.
# Deliberate bypass: git commit --no-verify
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

STAGED=$(git diff --cached --name-only --diff-filter=ACM)
FAIL=0

# 1. STE linter on staged markdown (blocks at >= 2.0 violations/100w)
MD_FILES=$(printf '%s\n' "$STAGED" | grep -E '\.(md|markdown)$' || true)
# STE exemption list (.ste-exempt): historical ledgers, amend-only by
# convention. New entries in them must still be written STE-clean.
if [ -f .ste-exempt ]; then
    MD_FILES=$(printf '%s\n' "$MD_FILES" | grep -vxFf <(grep -vE '^\s*(#|$)' .ste-exempt) || true)
fi
if [ -n "$MD_FILES" ]; then
    python3 ste-lint.py --fail-above 2.0 $MD_FILES || FAIL=1
fi

# 2. Provenance on staged campaign CSVs
CSV_FILES=$(printf '%s\n' "$STAGED" | grep -E '\.csv$' || true)
if [ -n "$CSV_FILES" ]; then
    python3 check-provenance.py $CSV_FILES || FAIL=1
fi

# 3. TDD cue: a src/ change with no test change. WARN only, never blocks: a pure
#    refactor or a comment fix legitimately touches src/ alone.
if [ -n "$STAGED" ]; then
    python3 check-tdd-evidence.py $STAGED || true
fi

if [ "$FAIL" = "1" ]; then
    echo ""
    echo "Habit-hook sensors fired. Fix the [HOOK:...] items above, then re-commit."
    echo "Deliberate bypass: git commit --no-verify"
    exit 1
fi
exit 0
=== pre-push hook ===
#!/usr/bin/env bash
# .githooks/pre-push — warn when a push touches the slow acceptance paths.
# Version: 0.1.0 | Date: 2026-08-20 | Author: Windswept & Interesting
#
# The acceptance suite (test/acceptance_runtests.jl) is ~5-8 min and runs in
# CI only when the paths below change. This hook WARNS (does not block) so a
# physics change is not pushed without the acceptance suite having run.
# CI (.github/workflows/acceptance.yml) is the authoritative gate.
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

REMOTE="$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null || true)"
if [ -z "$REMOTE" ]; then
    exit 0
fi

CHANGED="$(git diff --name-only "$REMOTE"...HEAD 2>/dev/null || true)"

# Keep this list in sync with .github/workflows/acceptance.yml.
MATCH="$(printf '%s\n' "$CHANGED" | grep -E '^(src/|scripts/ode_gate_v13\.jl|scripts/compute_seeds\.jl|test/acceptance_runtests\.jl|test/test_(evaluator_v13|gate_v13|rope_break|rotor_power_realism|settle_drag_alignment)\.jl)$' || true)"

if [ -n "$MATCH" ]; then
    echo ""
    echo "WARNING: this push touches acceptance-path files (src/ physics or the acceptance tests)."
    echo "Run the acceptance suite:"
    echo "    julia --project=. test/acceptance_runtests.jl"
    echo "CI will also run it (see .github/workflows/acceptance.yml)."
    echo ""
fi
exit 0
