+def strip_references(t):
+    """Drop the numbered entry list of a References or Bibliography section.
+    Reference entries are quoted titles and author lists, so they carry no STE
+    signal. The section prose is still counted."""
+    out = []
+    in_refs = False
+    for line in t.split("\n"):
+        if re.match(r"^##\s+(?:\d+\.?\s*)?(?:References|Bibliography)\s*$", line):
+            in_refs = True
+            out.append(line)
+            continue
+        if in_refs and re.match(r"^##\s", line):
+            in_refs = False
+        if in_refs and re.match(r"^\s*\d+\.\s", line):
+            continue
+        out.append(line)
+    return "\n".join(out)
+
