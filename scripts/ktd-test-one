#!/usr/bin/env bash
# scripts/ktd-test-one — run ONE test file under the repo sandbox environment.
#
# WHY THIS EXISTS
#   Most files in test/ are fragments: they hold @testset blocks but no `using`
#   lines, because test/runtests.jl supplies them.  Until now the only way to run
#   one of them was the whole 3.5-minute fast suite.  That cost is why a failing
#   test is often written without ever being watched fail.
#
#   This script runs a single file in seconds.  Use it for the RED step of the
#   loop: a new guard is not red until this prints FAIL and names the reason.
#
# USAGE
#   scripts/ktd-test-one test_blade_mass_law          # bare name
#   scripts/ktd-test-one test_blade_mass_law.jl       # or with .jl
#   scripts/ktd-test-one test/test_blade_mass_law.jl  # or a path
#
# EXIT
#   0 = test file passed, 1 = test file failed, 2 = usage or setup error.
#   The full output is kept at .julia_depot/logs/ktd-test-one.log.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

if [ "$#" -lt 1 ]; then
    echo "usage: scripts/ktd-test-one <test file name or path>" >&2
    exit 2
fi

ARG="$1"
case "$ARG" in
    *.jl) FILE="$ARG" ;;
    *)    FILE="test/$ARG.jl" ;;
esac
if [ ! -f "$FILE" ]; then
    echo "ktd-test-one: no such test file: $FILE" >&2
    exit 2
fi

ABS="$(cd "$(dirname "$FILE")" && pwd)/$(basename "$FILE")"
NAME="$(basename "$FILE" .jl)"
DRIVER="$ROOT/.julia_depot/ktd-test-one-driver.jl"
LOG="$ROOT/.julia_depot/logs/ktd-test-one.log"
mkdir -p "$(dirname "$LOG")"

# A file that imports the package itself runs as-is.  A fragment needs a driver
# that supplies the imports and the enclosing testset, exactly as runtests.jl
# does.  The enclosing testset matters: a bare @test outside a testset prints and
# then throws, so a fragment would report the first failure only.
if grep -qE '^\s*using\s+KiteTurbineDynamics' "$FILE"; then
    RUN="$ABS"
    MODE="standalone"
else
    cat > "$DRIVER" <<JULIA
# Generated by scripts/ktd-test-one. Do not edit; it is overwritten each run.
using Test
using KiteTurbineDynamics

@testset "single-file run: $NAME" begin
    include("$ABS")
end
JULIA
    RUN="$DRIVER"
    MODE="driver"
fi

echo "ktd-test-one: $FILE  (mode: $MODE)"
set +e
"$ROOT/scripts/ktd-julia" "$RUN" > "$LOG" 2>&1
STATUS=$?
set -e

if [ "$STATUS" -eq 0 ]; then
    echo "PASS  $NAME"
    grep -E "^(Test Summary| *[A-Za-z].*\| *[0-9]+ *(pass|fail))" "$LOG" | tail -12 || true
    exit 0
fi

echo "FAIL  $NAME  (exit $STATUS)"
echo "--- first failure ---"
FIRST="$(grep -m1 -E 'Test Failed at|Error During Test|Test threw exception' "$LOG" || true)"
if [ -z "$FIRST" ]; then
    FIRST="$(grep -m1 -E 'LoadError|ERROR:' "$LOG" || true)"
fi
if [ -z "$FIRST" ]; then
    FIRST="$(tail -5 "$LOG")"
fi
echo "$FIRST"
echo "--- summary ---"
grep -E "^Test Summary|^ *[A-Za-z0-9_ ]+\| *[0-9]+ +(pass|fail)" "$LOG" | tail -8 || true
echo "--- full output: $LOG ---"
exit 1
